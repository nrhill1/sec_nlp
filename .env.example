# sec-nlp Environment Configuration Example
# Copy this file to .env and customize for your setup

# ============================================================================
# REQUIRED: SEC EDGAR Email Contact
# ============================================================================
# SEC requires a valid email address for all EDGAR requests
# Set this for each pipeline you plan to use

SEC_NLP_ANALYZE_EMAIL=you@example.com
SEC_NLP_EXB_EMAIL=you@example.com
SEC_NLP_WARRANTY_EMAIL=you@example.com
SEC_NLP_FINANCIALS_EMAIL=you@example.com
SEC_NLP_HOLDINGS_EMAIL=you@example.com
SEC_NLP_INSIDER_EMAIL=you@example.com
SEC_NLP_NEWS_EMAIL=you@example.com
SEC_NLP_EVENTS_EMAIL=you@example.com
SEC_NLP_RETRIEVE_EMAIL=you@example.com
SEC_NLP_CHAT_EMAIL=you@example.com

# ============================================================================
# Ollama Configuration (Global)
# ============================================================================
# Base URL for Ollama server (affects all pipelines that use LLMs)
SEC_NLP_OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# ANALYZE Pipeline Configuration
# ============================================================================
# Prefix: SEC_NLP_ANALYZE_

# --- Filing Parameters ---
# Ticker symbols to analyze (comma-separated or JSON array)
# SEC_NLP_ANALYZE_SYMBOLS=["AAPL","MSFT","GOOGL"]

# Filing mode: annual, quarterly, current, proxy, holdings, registration, shelf_registration, insider
# SEC_NLP_ANALYZE_MODE=annual

# Maximum filings per symbol
# SEC_NLP_ANALYZE_LIMIT=5

# --- LLM Configuration ---
# LLM model name (must be pulled via `ollama pull`)
SEC_NLP_ANALYZE_LLM__MODEL_NAME=llama3.2:1b

# LLM base URL (overrides SEC_NLP_OLLAMA_BASE_URL if set)
# SEC_NLP_ANALYZE_LLM__BASE_URL=http://localhost:11434

# LLM temperature (0.0 = deterministic, 2.0 = creative)
# SEC_NLP_ANALYZE_LLM__TEMPERATURE=0.25

# Maximum tokens for LLM generation
# SEC_NLP_ANALYZE_LLM__MAX_NEW_TOKENS=6144

# Require JSON-formatted output
# SEC_NLP_ANALYZE_LLM__REQUIRE_JSON=true

# HTTP timeout for LLM health checks (seconds)
# SEC_NLP_ANALYZE_LLM__TIMEOUT=5

# --- Vector Database Configuration ---
# Collection name for vector storage
# SEC_NLP_ANALYZE_VDB__COLLECTION_NAME=analyze

# Embedding model (must be pulled via `ollama pull`)
SEC_NLP_ANALYZE_VDB__EMBEDDING_MODEL=bge-m3

# Vector dimension size (must match embedding model)
# SEC_NLP_ANALYZE_VDB__VECTOR_SIZE=1024

# Qdrant location: `:memory:` for in-memory, or path for persistent storage
# SEC_NLP_ANALYZE_VDB__QDRANT_LOCATION=:memory:

# Qdrant server URL (overrides location when set)
# SEC_NLP_ANALYZE_VDB__QDRANT_URL=http://localhost:6333

# Qdrant server host (when not using URL)
# SEC_NLP_ANALYZE_VDB__QDRANT_HOST=localhost

# Qdrant HTTP port
# SEC_NLP_ANALYZE_VDB__QDRANT_PORT=6333

# Qdrant gRPC port
# SEC_NLP_ANALYZE_VDB__QDRANT_GRPC_PORT=6334

# Qdrant API key (if authentication is required)
# SEC_NLP_ANALYZE_VDB__QDRANT_API_KEY=your_api_key_here

# Use HTTPS for Qdrant connection
# SEC_NLP_ANALYZE_VDB__QDRANT_HTTPS=false

# Prefer gRPC over HTTP
# SEC_NLP_ANALYZE_VDB__QDRANT_PREFER_GRPC=false

# Qdrant request timeout (seconds)
# SEC_NLP_ANALYZE_VDB__QDRANT_TIMEOUT=60

# Distance metric: Cosine, Euclid, or Dot
# SEC_NLP_ANALYZE_VDB__QDRANT_DISTANCE=Cosine

# Search type: similarity, mmr
# SEC_NLP_ANALYZE_VDB__SEARCH_TYPE=mmr

# Embedding batch size
# SEC_NLP_ANALYZE_VDB__EMBEDDING_BATCH_SIZE=32

# Store payload on disk to save RAM
# SEC_NLP_ANALYZE_VDB__QDRANT_ON_DISK_PAYLOAD=false

# --- Vector Mode ---
# Vector DB mode: off (disabled), read (search only), write (index + search)
# SEC_NLP_ANALYZE_VECTOR_MODE=write

# --- Content Filtering ---
# Topics to prioritize (JSON array format)
# SEC_NLP_ANALYZE_TOPICS=["warranty","recall","supply chain"]

# Keywords to filter content (JSON array format)
# SEC_NLP_ANALYZE_KEYWORDS=["exclusive","aftermarket"]

# Minimum topic keyword hits to keep a chunk
# SEC_NLP_ANALYZE_MIN_TOPIC_HITS=1

# Keyword matching mode: any, all
# SEC_NLP_ANALYZE_KEYWORD_MODE=any

# --- Section Filtering ---
# Section type: exhibit, item, part, custom
# SEC_NLP_ANALYZE_SECTION_TYPE=item

# Section numbers to extract (JSON array format, e.g., ["1A", "7"])
# SEC_NLP_ANALYZE_SECTION_NUMBERS=["1A"]

# Custom regex pattern for section matching (when section_type=custom)
# SEC_NLP_ANALYZE_CUSTOM_SECTION_PATTERN=

# Filter out table of contents and indices
# SEC_NLP_ANALYZE_FILTER_INDICES=true

# Character window to search for section markers
# SEC_NLP_ANALYZE_SEARCH_WINDOW=3000

# --- Chunking Configuration ---
# Chunking mode: sentence, semantic
# SEC_NLP_ANALYZE_CHUNKING_MODE=semantic

# Sentences per chunk (sentence mode)
# SEC_NLP_ANALYZE_CHUNK_SIZE=50

# Sentence overlap between chunks
# SEC_NLP_ANALYZE_CHUNK_OVERLAP=2

# Similarity threshold for semantic chunking (lower = more splits)
# SEC_NLP_ANALYZE_SEMANTIC_SIMILARITY_THRESHOLD=0.5

# Min sentences per chunk (semantic mode)
# SEC_NLP_ANALYZE_SEMANTIC_MIN_CHUNK_SENTENCES=3

# Max sentences per chunk (semantic mode)
# SEC_NLP_ANALYZE_SEMANTIC_MAX_CHUNK_SENTENCES=50

# Maximum characters per chunk
# SEC_NLP_ANALYZE_MAX_CHUNK_LENGTH=1000000

# Minimum characters required for a chunk
# SEC_NLP_ANALYZE_MIN_CHUNK_LENGTH=300

# --- Chunk Filtering ---
# Prioritize chunks by topic hit count
# SEC_NLP_ANALYZE_PRIORITIZE_TOPICS=true

# Keep only top-K scored chunks
# SEC_NLP_ANALYZE_TOP_K_CHUNKS=20

# Cap applied to top-k selection
# SEC_NLP_ANALYZE_ADAPTIVE_TOP_K_CAP=20

# Maximum chunks to analyze per filing
# SEC_NLP_ANALYZE_MAX_CHUNKS_PER_FILING=

# --- Deduplication ---
# Remove duplicate chunks before analysis
# SEC_NLP_ANALYZE_DEDUPLICATE_CHUNKS=true

# Token-overlap threshold for deduplication (0.0-1.0)
# SEC_NLP_ANALYZE_SIMILARITY_THRESHOLD_DEDUP=0.7

# SimHash bits for fingerprinting
# SEC_NLP_ANALYZE_SIMHASH_BITS=64

# Maximum hamming distance for duplicates
# SEC_NLP_ANALYZE_SIMHASH_MAX_DISTANCE=6

# --- Search Configuration ---
# Search queries (JSON array format)
# SEC_NLP_ANALYZE_SEARCH__QUERIES=["exclusive supply agreements","aftermarket pricing"]

# Maximum results per search query
# SEC_NLP_ANALYZE_SEARCH__LIMIT=10

# Similarity score threshold (0.0-1.0)
# SEC_NLP_ANALYZE_SEARCH__SCORE_THRESHOLD=0.5

# Run LLM analysis on search results
# SEC_NLP_ANALYZE_SEARCH__ANALYZE=true

# Max search hits to analyze per query
# SEC_NLP_ANALYZE_SEARCH__ANALYZE_LIMIT=5

# Export search results to files
# SEC_NLP_ANALYZE_SEARCH__EXPORT_RESULTS=true

# Minimum query terms that must appear in chunk
# SEC_NLP_ANALYZE_SEARCH__QUERY_TERM_MIN_HITS=1

# Minimum fraction of query terms required (0.0-1.0)
# SEC_NLP_ANALYZE_SEARCH__QUERY_TERM_MIN_RATIO=0.3

# Minimum length for query terms in lexical gating
# SEC_NLP_ANALYZE_SEARCH__QUERY_TERM_MIN_LEN=3

# --- EFTS (EDGAR Full-Text Search) Configuration ---
# Enable EFTS search for filing discovery
# SEC_NLP_ANALYZE_EFTS__ENABLED=true

# Maximum EFTS results per query
# SEC_NLP_ANALYZE_EFTS__LIMIT=20

# Minimum EFTS relevance score (0.0 = no threshold)
# SEC_NLP_ANALYZE_EFTS__SCORE_THRESHOLD=0.0

# Auto-download high-scoring EFTS hits
# SEC_NLP_ANALYZE_EFTS__AUTO_DOWNLOAD=true

# Max filings to auto-download from EFTS
# SEC_NLP_ANALYZE_EFTS__AUTO_DOWNLOAD_LIMIT=5

# Form types for EFTS search (JSON array, empty = use pipeline mode)
# SEC_NLP_ANALYZE_EFTS__FORMS=[]

# Expand EFTS date range beyond pipeline config
# SEC_NLP_ANALYZE_EFTS__EXPAND_DATE_RANGE=true

# Years of filings to search when expanding date range
# SEC_NLP_ANALYZE_EFTS__DATE_RANGE_YEARS=3

# --- Analysis Configuration ---
# Number of chunks to process in parallel
# SEC_NLP_ANALYZE_BATCH_SIZE=8

# Minimum confidence score for relevance (0.0-1.0)
# SEC_NLP_ANALYZE_CONFIDENCE_THRESHOLD=0.7

# Confidence mode: llm, calibrated
# SEC_NLP_ANALYZE_CONFIDENCE_MODE=calibrated

# LLM retry attempts before fallback
# SEC_NLP_ANALYZE_LLM_RETRY_ATTEMPTS=2

# Initial backoff for LLM retry (seconds)
# SEC_NLP_ANALYZE_LLM_RETRY_BACKOFF=1.0

# Fields to extract from LLM analysis (JSON array)
# SEC_NLP_ANALYZE_ANALYSIS_FIELDS=["is_relevant","confidence_score","summary","key_points","reasoning","tags","sentiment"]

# --- Market Enrichment ---
# Enable market data enrichment
# SEC_NLP_ANALYZE_MARKET__ENABLED=true

# Ticker for market data (defaults to analysis symbol)
# SEC_NLP_ANALYZE_MARKET__TICKER=

# Market data granularity: daily, weekly, monthly, quarterly, annual
# SEC_NLP_ANALYZE_MARKET__GRANULARITY=

# Limit of aggregated rows to include
# SEC_NLP_ANALYZE_MARKET__LIMIT=

# Include market correlation metrics
# SEC_NLP_ANALYZE_MARKET_CORRELATION_ENABLED=true

# --- Async Processing ---
# Async mode: sync, async, auto
# SEC_NLP_ANALYZE_ASYNC_MODE=auto

# Max concurrent async operations
# SEC_NLP_ANALYZE_ASYNC_MAX_CONCURRENT=4

# Use async HTML processing in loader
# SEC_NLP_ANALYZE_LOADER_USE_ASYNC=true

# Max workers for loader async processing
# SEC_NLP_ANALYZE_LOADER_MAX_WORKERS=2

# --- Output Configuration ---
# Export format: json, csv, yaml, both (json+csv), yaml_csv (yaml+csv)
# SEC_NLP_ANALYZE_EXPORT_FORMAT=yaml

# Include raw chunks in output files
# SEC_NLP_ANALYZE_INCLUDE_RAW_CHUNKS=false

# Aggregate results by filing vs per-chunk
# SEC_NLP_ANALYZE_AGGREGATE_BY_FILING=true

# Show related filing timelines in logs
# SEC_NLP_ANALYZE_SHOW_TIMELINE=false

# --- Processing Options ---
# Skip empty sections
# SEC_NLP_ANALYZE_SKIP_EMPTY_SECTIONS=true

# Document categories to skip (JSON array)
# SEC_NLP_ANALYZE_SKIP_CATEGORIES=[]

# --- Tracing & Logging ---
# Enable LangChain callback tracing
# SEC_NLP_ANALYZE_ENABLE_TRACING=false

# Include prompt text in trace logs
# SEC_NLP_ANALYZE_TRACE_LOG_PROMPTS=false

# --- Metrics ---
# Collect and report performance metrics
# SEC_NLP_ANALYZE_COLLECT_METRICS=true

# --- Paths ---
# Download path for raw SEC filings
# SEC_NLP_ANALYZE_DL_PATH=downloads

# Output path for analysis results
# SEC_NLP_ANALYZE_OUT_PATH=outputs

# Log path for pipeline logs
# SEC_NLP_ANALYZE_LOG_PATH=logs

# ============================================================================
# EXHIBIT (EXB) Pipeline Configuration
# ============================================================================
# Prefix: SEC_NLP_EXB_

# --- Filing Parameters ---
# Ticker symbols to analyze
# SEC_NLP_EXB_SYMBOLS=["CAT","DE","HON"]

# Filing mode: annual, quarterly, current
# SEC_NLP_EXB_MODE=annual

# Maximum filings per symbol
# SEC_NLP_EXB_LIMIT=5

# --- Vector Database Configuration ---
# Collection name
# SEC_NLP_EXB_VDB__COLLECTION_NAME=exhibit

# Embedding model
SEC_NLP_EXB_VDB__EMBEDDING_MODEL=mxbai-embed-large

# Vector dimension size
# SEC_NLP_EXB_VDB__VECTOR_SIZE=1024

# Qdrant location or URL (same options as ANALYZE)
# SEC_NLP_EXB_VDB__QDRANT_LOCATION=:memory:
# SEC_NLP_EXB_VDB__QDRANT_URL=http://localhost:6333

# Search type: similarity, cosine
# SEC_NLP_EXB_VDB__SEARCH_TYPE=cosine

# --- Exhibit Configuration ---
# Exhibit categories: contracts, subsidiaries, consents, financials, xbrl, all
# SEC_NLP_EXB_EXHIBIT_CATEGORIES=["contracts","subsidiaries","consents"]

# Explicit exhibit numbers (JSON array, e.g., ["10","21","23"])
# SEC_NLP_EXB_EXHIBIT_NUMBERS=[]

# Contract categories: supply, credit, employment, lease, license, service, all
# SEC_NLP_EXB_CONTRACT_CATEGORIES=["supply"]

# --- Search Configuration ---
# Search terms for contract exhibits (JSON array)
# SEC_NLP_EXB_SEARCH_TERMS=["exclusive","supply agreement","aftermarket"]

# Search queries for semantic search (JSON array)
# SEC_NLP_EXB_SEARCH__QUERIES=[]

# Max results per search query
# SEC_NLP_EXB_SEARCH__LIMIT=10

# Score threshold for search results
# SEC_NLP_EXB_SEARCH__SCORE_THRESHOLD=0.5

# --- Chunking Configuration ---
# Max sentences per chunk
# SEC_NLP_EXB_CHUNK_SIZE=20

# Sentence overlap between chunks
# SEC_NLP_EXB_CHUNK_OVERLAP=3

# Minimum characters per chunk
# SEC_NLP_EXB_MIN_CHUNK_CHARS=120

# Enable adaptive chunk sizing
# SEC_NLP_EXB_ADAPTIVE_CHUNKING=true

# --- Filtering Configuration ---
# Max non-keyword chunks per filing
# SEC_NLP_EXB_MAX_NON_KEYWORD_CHUNKS=25

# Max chunks per filing after filtering
# SEC_NLP_EXB_MAX_CHUNKS_PER_FILING=

# Min distinct keyword categories required
# SEC_NLP_EXB_REQUIRE_KEYWORD_CATEGORIES=1

# Enable keyword prefiltering
# SEC_NLP_EXB_PREFILTER_KEYWORDS=true

# Enable section-term prefiltering
# SEC_NLP_EXB_PREFILTER_SECTION_TERMS=true

# Prefilter character window
# SEC_NLP_EXB_CHUNK_PREFILTER_WINDOW=6000

# Prefilter minimum HTML length
# SEC_NLP_EXB_CHUNK_PREFILTER_MIN_LENGTH=40

# Exhibits allowed through without keywords
# SEC_NLP_EXB_PREFILTER_ALLOW_NO_KEYWORD=3

# Deduplicate chunks
# SEC_NLP_EXB_DEDUPE_CHUNKS=true

# --- Processing Options ---
# Batch size for parallel processing
# SEC_NLP_EXB_BATCH_SIZE=16

# Dry run (skip vector upload)
# SEC_NLP_EXB_DRY_RUN=false

# Search only mode (skip indexing)
# SEC_NLP_EXB_SEARCH_ONLY=false

# --- Output Configuration ---
# Export format: json, yaml, csv, both (yaml+csv)
# SEC_NLP_EXB_EXPORT_FORMAT=yaml

# Include detailed per-chunk analysis
# SEC_NLP_EXB_VERBOSE_OUTPUT=false

# --- Paths ---
# SEC_NLP_EXB_DL_PATH=downloads
# SEC_NLP_EXB_OUT_PATH=outputs
# SEC_NLP_EXB_LOG_PATH=logs

# ============================================================================
# WARRANTY Pipeline Configuration
# ============================================================================
# Prefix: SEC_NLP_WARRANTY_

# --- Filing Parameters ---
# Ticker symbols to analyze
# SEC_NLP_WARRANTY_SYMBOLS=["AAPL"]

# Filing mode (only annual/10-K supported)
# SEC_NLP_WARRANTY_MODE=annual

# Maximum filings per symbol
# SEC_NLP_WARRANTY_LIMIT=1

# --- Extraction Configuration ---
# XBRL-only mode (always true, LLM disabled)
# SEC_NLP_WARRANTY_XBRL_ONLY=true

# Keywords to bias loader (JSON array)
# SEC_NLP_WARRANTY_KEYWORDS=["warranty","accrual","reserve","revenue"]

# --- Processing Options ---
# Max symbols to process in parallel
# SEC_NLP_WARRANTY_MAX_PARALLEL_SYMBOLS=1

# Use async HTML processing
# SEC_NLP_WARRANTY_LOADER_USE_ASYNC=true

# Max workers for loader async processing
# SEC_NLP_WARRANTY_LOADER_MAX_WORKERS=4

# --- Section Filtering ---
# Apply Item 8 section filter
# SEC_NLP_WARRANTY_USE_ITEM_8_FILTER=true

# Item numbers to include (JSON array)
# SEC_NLP_WARRANTY_ITEM_FILTER_NUMBERS=["8"]

# Character window for section detection
# SEC_NLP_WARRANTY_ITEM_FILTER_SEARCH_WINDOW=3000

# Filter out indices
# SEC_NLP_WARRANTY_ITEM_FILTER_EXCLUDE_INDICES=true

# --- Chunking Configuration ---
# Max sentences per chunk
# SEC_NLP_WARRANTY_CHUNK_SIZE=15

# Sentence overlap
# SEC_NLP_WARRANTY_CHUNK_OVERLAP=2

# --- Output Configuration ---
# Export format: json, csv, both (json+csv)
# SEC_NLP_WARRANTY_EXPORT_FORMAT=both

# Combined CSV path (defaults to pipeline output directory)
# SEC_NLP_WARRANTY_COMBINED_CSV=

# --- Paths ---
# SEC_NLP_WARRANTY_DL_PATH=downloads
# SEC_NLP_WARRANTY_OUT_PATH=outputs
# SEC_NLP_WARRANTY_LOG_PATH=logs

# ============================================================================
# Additional Notes
# ============================================================================
#
# - Nested fields use double underscores (__) in environment variables
# - Example: SEC_NLP_ANALYZE_LLM__MODEL_NAME maps to llm.model_name
#
# - Lists/arrays must be JSON formatted in .env:
#   SEC_NLP_ANALYZE_TOPICS=["warranty","recall"]
#   SEC_NLP_ANALYZE_SYMBOLS=["AAPL","MSFT"]
#
# - CLI arguments override environment variables
# - CLI uses dot notation: --llm.model-name llama3.2:1b
#
# - To disable vector DB entirely: SEC_NLP_ANALYZE_VECTOR_MODE=off
# - For persistent Qdrant: SEC_NLP_ANALYZE_VDB__QDRANT_URL=http://localhost:6333
# - For in-memory Qdrant: SEC_NLP_ANALYZE_VDB__QDRANT_LOCATION=:memory:
#
# - Start Qdrant with Docker: sec-nlp qdrant up
# - Pull Ollama models: ollama pull llama3.2:1b
